{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": [
      "node",
      "@playwright/test"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // 👇 CONFIGURACIÓN DE ALIAS DE RUTAS
    "baseUrl": ".",
    "paths": {
      "@pages/*": [
        "pages/*"
      ],
      "@utils/*": [
        "utils/*"
      ],
      "@tests/*": [
        "tests/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "playwright.config.ts"
  ]
}